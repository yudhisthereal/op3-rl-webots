{
  "mode": "train",
  "model_path": "controllers/op3_ddpg/checkpoints/ddpg_final.pt",
  
  "control_joints": [
    "ShoulderR", "ShoulderL", 
    "ArmUpperR", "ArmUpperL", 
    "ArmLowerR", "ArmLowerL",
    "LegUpperR", "LegUpperL",
    "LegLowerR", "LegLowerL"
  ],
  
  "goal_angles": {
    "ShoulderR": 1.0,
    "ShoulderL": -1.0,
    "ArmUpperR": -0.9,
    "ArmUpperL": 0.9,
    "ArmLowerR": 0.4,
    "ArmLowerL": -0.4,
    "LegUpperR": 0.57,
    "LegUpperL": -0.57,
    "LegLowerR": -1.5,
    "LegLowerL": 1.5
  },
  
  "training": {
    "max_episodes": 10000,
    "max_steps": 30,
    "timestep": 32,
    
    "ddpg": {
      "actor_lr": 1e-4,
      "critic_lr": 1e-3,
      "gamma": 0.99,
      "tau": 0.005,
      "noise_std_start": 0.3,
      "noise_std_end": 0.01,
      "noise_decay": 0.9998,
      "batch_size": 64,
      "replay_buffer_size": 100000
    },
    
    "reward": {
      "angle_tolerance": 0.025,
      "success_reward": 10.0,
      "angle_error_weight": -1.0
    },
    
    "joint_limits": {
      "ShoulderR": [-1.57, 1.57],
      "ArmUpperR": [-1.57, 1.57],
      "ArmLowerR": [0.00, 1.57],
      "LegUpperR": [0.00, 1.57],
      "LegLowerR": [-1.57, 0.00],
      "ShoulderL": [-1.57, 1.57],
      "ArmUpperL": [-1.57, 1.57],
      "ArmLowerL": [-1.57, 0.00],
      "LegUpperL": [-1.57, 0.00],
      "LegLowerL": [0.00, 1.57]
    }
  },
  
  "early_stopping": {
    "enabled": true,
    "window_size": 50,
    "success_threshold": 1.0,
    "min_episodes": 100
  },
  
  "checkpoints": {
    "save_every": 100,
    "save_best": true
  },
  "visualization": {
    "save_plot": true,
    "save_every": 50
  }
}